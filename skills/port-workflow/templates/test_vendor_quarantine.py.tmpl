"""The vendored em-semi code must reach nothing that is not in the job image or in this package.

Generated by /port-workflow from the analog-trim pattern (`test_vendor_is_self_contained.py`).
`{{PKG}}.vendor` is em-semi's code rewritten by `scripts/vendor_workflow.sh` and by no hand. Every
em-semi platform import was redirected to a shim or stand-in; this module refuses one that was not,
because in the container it is an ImportError at run time, halfway through a run.
"""

from __future__ import annotations

import ast
import importlib
import sys
from pathlib import Path

import pytest

VENDOR = Path(__file__).resolve().parents[1] / "src" / "{{PKG}}" / "vendor"

#: The python-runner image's own manifest, read rather than copied, so it cannot drift. Found by
#: walking up to craft's root rather than by a fixed depth, which broke once when bundles moved.
_RUNNER_REQUIREMENTS = Path("compute-plane-python") / "python-runner" / "requirements.txt"
_REQUIREMENTS = next(
    parent / _RUNNER_REQUIREMENTS for parent in Path(__file__).resolve().parents if (parent / _RUNNER_REQUIREMENTS).is_file()
)
_IMPORT_NAME = {"scikit-learn": "sklearn"}

FORBIDDEN_ROOTS = frozenset({"app", "common_semi", "prefect", "tests"})


def _baked_roots() -> frozenset[str]:
    lines = (line.strip() for line in _REQUIREMENTS.read_text(encoding="utf-8").splitlines())
    names = (line.partition("==")[0] for line in lines if line and not line.startswith("#"))
    return frozenset(_IMPORT_NAME.get(name, name) for name in names)


PERMITTED_ROOTS = _baked_roots() | {"{{PKG}}"}
MODULES = sorted(path.relative_to(VENDOR) for path in VENDOR.rglob("*.py"))


def _dotted(path: Path) -> str:
    parts = path.with_suffix("").parts
    trimmed = parts[:-1] if parts[-1] == "__init__" else parts
    return ".".join(("{{PKG}}", "vendor", *trimmed))


def _imported_roots(path: Path) -> set[str]:
    tree = ast.parse((VENDOR / path).read_text(encoding="utf-8"))
    roots: set[str] = set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            roots.update(alias.name.split(".")[0] for alias in node.names)
        elif isinstance(node, ast.ImportFrom) and node.level == 0 and node.module:
            roots.add(node.module.split(".")[0])
    return roots


def test_the_vendored_tree_is_not_empty() -> None:
    # A rewrite that silently produced nothing would make every other test here vacuous.
    assert MODULES


@pytest.mark.parametrize("path", MODULES, ids=str)
def test_it_imports_nothing_em_semi_owns(path: Path) -> None:
    assert not _imported_roots(path) & FORBIDDEN_ROOTS


@pytest.mark.parametrize("path", MODULES, ids=str)
def test_every_third_party_import_is_in_the_job_image(path: Path) -> None:
    unknown = {
        root for root in _imported_roots(path) if root not in PERMITTED_ROOTS and root not in sys.stdlib_module_names
    }
    assert not unknown, f"not in the runner image: {sorted(unknown)} (record in PORT_GAPS.md)"


@pytest.mark.parametrize("path", MODULES, ids=str)
def test_every_module_imports(path: Path) -> None:
    importlib.import_module(_dotted(path))
