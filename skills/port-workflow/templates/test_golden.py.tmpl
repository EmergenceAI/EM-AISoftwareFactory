"""Live node outputs against the committed golden, field by field.

Generated by /port-workflow from the analog-trim pattern (`test_craft_trim_golden.py` +
`_golden.py`). `fixtures/golden-node-outputs.json` is written by `scripts/make_fixtures.py` from
`_golden.node_outputs()`, the same function this test calls, so the committed file cannot drift
away from what the nodes emit without something going red. Floats agree within a relative 1e-6;
LLM-generated text is compared by structure only (its quality is the evals' job).
"""

from __future__ import annotations

import json
import math
from typing import Any

import pytest

from _golden import GOLDEN, LLM_TEXT_PATHS, node_outputs

NODES = [{{NODES}}]
REL_TOL = 1e-6


@pytest.fixture(scope="module")
def committed() -> dict[str, Any]:
    return dict(json.loads(GOLDEN.read_text(encoding="utf-8")))


@pytest.fixture(scope="module")
def live() -> dict[str, Any]:
    return node_outputs()


def mismatches(live: Any, pinned: Any, path: str = "") -> list[str]:
    """Every place the two disagree, each named by the path that reaches it."""
    if path in LLM_TEXT_PATHS:
        return [] if isinstance(live, type(pinned)) else [f"{path}: {type(live).__name__} vs {type(pinned).__name__}"]
    if isinstance(live, dict) and isinstance(pinned, dict):
        if set(live) != set(pinned):
            return [f"{path}: fields {sorted(set(live) ^ set(pinned))} are on one side only"]
        return [note for key in sorted(live) for note in mismatches(live[key], pinned[key], f"{path}.{key}")]
    if isinstance(live, list) and isinstance(pinned, list):
        if len(live) != len(pinned):
            return [f"{path}: {len(live)} item(s) against the golden's {len(pinned)}"]
        return [note for i, (a, b) in enumerate(zip(live, pinned)) for note in mismatches(a, b, f"{path}[{i}]")]
    if isinstance(live, float) and isinstance(pinned, (int, float)) and not isinstance(pinned, bool):
        return [] if math.isclose(live, pinned, rel_tol=REL_TOL) else [f"{path}: {live} != {pinned}"]
    return [] if live == pinned else [f"{path}: {live!r} != {pinned!r}"]


@pytest.mark.parametrize("node", NODES)
def test_node_output_matches_golden(node: str, live: dict[str, Any], committed: dict[str, Any]) -> None:
    assert not mismatches(live[node], committed[node], node)
