#!/usr/bin/env bash
# Vendors em-semi's workflow code and its tests into `{{VENDOR_PKG}}`.
#
# Generated by the Factory's /port-workflow skill from templates/vendor_workflow.sh.tmpl, which
# generalises craft/bundles/analog-trim/job/scripts/vendor_trim_opt.sh. Same guarantees:
#
# - The output is committed, so nobody needs em-semi to build or test this bundle. This script is
#   how that output is REPRODUCED.
# - It reads em-semi through `git ls-tree` / `git show` at a PINNED ref, never a checkout: that
#   repository is shared with other worktrees, and a moving `main` is a parity claim about a tree
#   nobody reviewed. Bump EM_SEMI_REF deliberately, in its own commit.
# - The only changes to em-semi's code are the import rewrites in `rewrite()` and the numbered
#   patches under `patches/`. A hand edit to a vendored file is what breaks the parity claim, and
#   a re-vendor reverts it in silence.
# - Only the Prefect orchestration is excluded (EXCLUDED_REGEX). Everything else is here.
#
#   EM_SEMI=~/Documents/Development/em-semi ./scripts/vendor_workflow.sh
#
# Layout: em-semi's `workflow/app/<x>` lands at `vendor/<x>`, `common/<x>` at `vendor/<x>`, and
# `workflow/tests/<x>` at `tests/vendor/<x>`. Top-level `vendor/_*.py` (shims) and
# `vendor/__init__.py` are craft's own and survive a re-vendor; everything else is rewritten.
set -euo pipefail

EM_SEMI="${EM_SEMI:-$HOME/Documents/Development/em-semi}"
EM_SEMI_REF="${EM_SEMI_REF:-{{EM_SEMI_REF}}}"

SRC_ROOTS=({{SRC_ROOTS}})
TEST_ROOTS=({{TEST_ROOTS}})
EXCLUDED_REGEX='{{EXCLUDED_REGEX}}'
VENDOR_PKG='{{VENDOR_PKG}}'

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
vendor="$here/src/${VENDOR_PKG//.//}"
vendor_tests="$here/tests/vendor"
patches="$here/patches"

# Everything is checked before anything is written: a bad ref must not leave a half-wiped tree.
if ! git -C "$EM_SEMI" rev-parse --git-dir >/dev/null 2>&1; then
  echo "no em-semi checkout at $EM_SEMI; set EM_SEMI" >&2
  exit 1
fi
if ! git -C "$EM_SEMI" rev-parse --verify --quiet "$EM_SEMI_REF^{commit}" >/dev/null; then
  echo "em-semi ref $EM_SEMI_REF does not resolve to a commit in $EM_SEMI" >&2
  exit 1
fi

list_files() {
  git -C "$EM_SEMI" ls-tree -r --name-only "$EM_SEMI_REF" -- "$@" | grep -vE "$EXCLUDED_REGEX" | sort || true
}

sources="$(list_files "${SRC_ROOTS[@]}")"
tests="$(list_files "${TEST_ROOTS[@]}")"
if [ -z "$sources" ]; then
  echo "nothing to vendor under ${SRC_ROOTS[*]} at $EM_SEMI_REF" >&2
  exit 1
fi

# Platform redirects (from the port's inventory) run first; the generic rules then point every
# remaining em-semi import at the vendored copy. An import left pointing at something that was not
# vendored is what the self-containment test refuses.
rewrite() {
  case "$1" in
    *.py) perl -pe '
{{IMPORT_REWRITES}}
      s{(?<![\w.])app\.}{'"$VENDOR_PKG"'.}g;
      s{(?<![\w.])common_semi\.}{'"$VENDOR_PKG"'.common_semi.}g;
    ' ;;
    *) cat ;;
  esac
}

dest_for() {
  local path="$1"
  case "$path" in
    workflow/app/*) echo "$vendor/${path#workflow/app/}" ;;
    workflow/tests/*) echo "$vendor_tests/${path#workflow/tests/}" ;;
    common/*) echo "$vendor/${path#common/}" ;;
    *) echo "$vendor/$path" ;;
  esac
}

emit() {
  local path dest
  while read -r path; do
    [ -n "$path" ] || continue
    dest="$(dest_for "$path")"
    mkdir -p "$(dirname "$dest")"
    git -C "$EM_SEMI" show "$EM_SEMI_REF:$path" | rewrite "$path" >"$dest"
  done
}

mkdir -p "$vendor"
find "$vendor" -mindepth 1 -maxdepth 1 ! -name '_*.py' ! -name '__init__.py' -exec rm -rf {} +
rm -rf "$vendor_tests"
mkdir -p "$vendor_tests"
[ -e "$vendor/__init__.py" ] || : >"$vendor/__init__.py"

emit <<<"$sources"
emit <<<"$tests"

# A patch that stops applying is a HARD failure: em-semi moved under it, and the conflict needs
# resolving by hand into a regenerated patch.
if compgen -G "$patches/*.patch" >/dev/null; then
  repo_root="$(git -C "$here" rev-parse --show-toplevel)"
  for patch in "$patches"/*.patch; do
    echo "applying $(basename "$patch")"
    if ! git -C "$repo_root" apply "$patch"; then
      echo "$(basename "$patch") no longer applies to $EM_SEMI_REF's output." >&2
      echo "Resolve against the new tree (git apply --3way), then regenerate the patch." >&2
      exit 1
    fi
  done
fi

echo "vendored $(wc -l <<<"$sources" | tr -d ' ') source and $(grep -c . <<<"$tests" || true) test files from $EM_SEMI_REF"
